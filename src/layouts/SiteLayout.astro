---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { getDeployment } from '../../scripts/deployment-config.mjs';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = `${site.name} — Software, AI & analytics`,
  description = site.description,
  noindex = false,
} = Astro.props;
const deployment = getDeployment();
const indexable = deployment.indexable && !noindex;
const canonical = deployment.siteUrl
  ? new URL(Astro.url.pathname, deployment.siteUrl).href
  : undefined;
const socialImage = deployment.siteUrl
  ? new URL('/social-card.png', deployment.siteUrl).href
  : '/social-card.png';
const structuredData =
  Astro.url.pathname === '/'
    ? {
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Person',
            ...(deployment.siteUrl && {
              '@id': `${deployment.siteUrl}#person`,
              url: deployment.siteUrl,
            }),
            name: site.name,
            sameAs: [site.github],
            address: {
              '@type': 'PostalAddress',
              addressLocality: site.location,
              addressCountry: 'SG',
            },
            knowsAbout: [
              'Software engineering',
              'Applied AI',
              'Full-stack development',
              'Business intelligence',
              'Predictive analytics',
              'Statistical analysis',
            ],
          },
          ...(deployment.siteUrl
            ? [
                {
                  '@type': 'WebSite',
                  url: deployment.siteUrl,
                  name: `${site.name} — Portfolio`,
                  author: { '@id': `${deployment.siteUrl}#person` },
                },
              ]
            : []),
        ],
      }
    : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={
        indexable
          ? 'index, follow'
          : noindex
            ? 'noindex, follow'
            : 'noindex, nofollow'
      }
    />
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f8f7f3" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={`${site.name} — Portfolio`} />
    <meta property="og:locale" content="en_SG" />
    {canonical && !noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${site.name} — software engineering and applied AI in Singapore.`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content={`${site.name} — software engineering and applied AI in Singapore.`}
    />
    {structuredData && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
      />
    )}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
