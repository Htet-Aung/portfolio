---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import PrintResume from '../components/PrintResume.astro';
import { site } from '../data/site';
import { profile, education, skills, projectBullets } from '../data/resume';
import { getPublishedProjects } from '../data/work';

const work = (await getPublishedProjects()).filter(
  ({ caseStudy }) => caseStudy,
);
---

<SiteLayout
  title={`Resume — ${site.name}`}
  description="Htet Aung Khant's engineering resume: selected software and applied AI projects, skills, education, and contact details."
>
  <div class="container resume-page">
    <div class="resume-toolbar">
      <p class="eyebrow">Resume / At a glance</p>
      <PrintResume />
    </div>
    <article class="resume-document" aria-label={`${site.name}'s resume`}>
      <header class="resume-identity">
        <h1>
          {site.name}
          <span class="accent">.</span>
        </h1>
        <p class="resume-focus">Software engineering · Applied AI</p>
        <ul class="resume-contact">
          <li>{site.location}</li>
          <li>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <a href={site.github}>github.com/Htet-Aung</a>
          </li>
        </ul>
      </header>
      <section class="resume-section" aria-labelledby="profile-title">
        <h2 id="profile-title">Profile</h2>
        <p>{profile}</p>
      </section>
      <section class="resume-section" aria-labelledby="projects-title">
        <h2 id="projects-title">Selected projects</h2>
        <div class="resume-projects">
          {work.map((project) => (
            <section
              class="resume-project"
              aria-labelledby={`resume-${project.id}`}
            >
              <div class="resume-project-heading">
                <h3 id={`resume-${project.id}`}>
                  <a href={project.caseStudy}>
                    {project.title}
                    <Arrow direction="up-right" />
                  </a>
                </h3>
                <span class="resume-project-stack">
                  {project.stack.slice(0, 3).join(' · ')}
                </span>
              </div>
              <p class="resume-project-role">
                {project.role}
                {project.teamContext !== 'Solo project' &&
                  ` · ${project.teamContext}`}
              </p>
              <ul>
                {projectBullets[project.id].map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </section>
      <section class="resume-section" aria-labelledby="skills-title">
        <h2 id="skills-title">Technical skills</h2>
        <dl class="resume-skills">
          {skills.map((skill) => (
            <div>
              <dt>{skill.label}</dt>
              <dd>{skill.items}</dd>
            </div>
          ))}
        </dl>
      </section>
      <section class="resume-section" aria-labelledby="education-title">
        <h2 id="education-title">Education</h2>
        <div class="resume-education">
          <strong>
            {education.institution}, {education.location}
          </strong>
          <p>{education.program}</p>
        </div>
      </section>
    </article>
    <div class="resume-bottom">
      <p>Prefer the stories behind the bullet points?</p>
      <a class="text-link" href="/#work">
        Read the case studies <Arrow />
      </a>
    </div>
  </div>
</SiteLayout>
