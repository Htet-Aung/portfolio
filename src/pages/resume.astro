---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import PrintResume from '../components/PrintResume.astro';
import ResumeDocument from '../components/ResumeDocument.astro';
import { site } from '../data/site';
import { getPublishedProjects } from '../data/work';

const projects = (await getPublishedProjects()).filter(
  (project) => project.caseStudy,
);
---

<SiteLayout
  title={`Resume — ${site.name}`}
  description="Htet Aung Khant's resume: software development, applied AI, business intelligence, predictive analytics, education, certificates, and leadership."
>
  <div class="container resume-page">
    <div class="resume-toolbar">
      <h1 class="eyebrow">Resume / At a glance</h1>
      <PrintResume />
    </div>
    <ResumeDocument projects={projects} />
    <div class="resume-bottom">
      <p>Explore the projects and the work behind them.</p>
      <a class="text-link" href="/#work">
        Read the case studies <Arrow />
      </a>
    </div>
  </div>
</SiteLayout>
