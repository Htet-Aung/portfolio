---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import { education, skills } from '../data/resume';
import { site } from '../data/site';
import { Image } from 'astro:assets';
import nypAiNokia from '../assets/community/nyp-ai-nokia-workshop.png';
import gdgPresenting from '../assets/community/gdg-cloud-run-presenting.png';
import gdgTeam from '../assets/community/gdg-cloud-run-team.png';

const capabilities = [
  {
    number: '01',
    title: 'Full-stack web development',
    text: 'Building responsive, accessible web applications with React, Node.js, and Flask, prioritizing reliable state management and clean component architecture.',
    links: [
      { title: 'SGEN', href: '/work/sgen/' },
      { title: 'ROLLOVER', href: '/work/rollover/' },
    ],
  },
  {
    number: '02',
    title: 'AI & media pipelines',
    text: 'Integrating multimodal AI APIs, audio processing with FFmpeg, and browser editors into cohesive creative tools.',
    links: [{ title: 'Shades of SG', href: '/work/shades-of-sg/' }],
  },
  {
    number: '03',
    title: 'Machine learning from scratch',
    text: 'Implementing foundational ML algorithms from first principles—such as reverse-mode autograd dynamic DAGs, vectorized convolutions, and optimizer logic.',
    links: [{ title: 'NumPyGrad', href: '/work/numpygrad/' }],
  },
  {
    number: '04',
    title: 'Business intelligence & predictive modeling',
    text: 'Building interactive Power BI operational dashboards, automated KNIME ETL pipelines, and regression models in SAS Viya.',
    links: [
      { title: 'Hospital Operations', href: '/work/hospital-operations/' },
      { title: 'Workout Energy Prediction', href: '/work/workout-prediction/' },
      { title: 'Retail Customer Analytics', href: '/work/retail-data/' },
    ],
  },
];
---

<SiteLayout
  title={`About — ${site.name}`}
  description="Learn about Htet Aung Khant's experience across full-stack development, applied AI, machine learning systems, and business intelligence."
>
  <div class="container inner-page about-page">
    <header class="inner-page-header">
      <h1>
        Software engineering
        <br />
        &amp; applied AI<span class="accent">.</span>
      </h1>
      <p class="inner-page-intro">
        I'm Htet, an Applied AI &amp; Analytics student at Nanyang Polytechnic in Singapore.
        I build full-stack web applications, machine learning tools, and data pipelines.
      </p>
    </header>
    <section class="about-profile" aria-labelledby="background-title">
      <div>
        <h2 id="background-title">
          Background
        </h2>
        <p>
          My work spans full-stack web applications, machine learning systems built from first principles, and data analytics tools. I've engineered projects ranging from an autograd deep learning engine in pure NumPy to an AI music video creation pipeline, accessible social feed applications, and hospital operational planning dashboards.
        </p>
        <p>
          I focus on writing clean, modular code and understanding the underlying mechanics—whether that means implementing dynamic computation graphs, configuring asynchronous media pipelines, or building dimensional data models in Power BI.
        </p>
      </div>
      <dl class="profile-notes">
        <div>
          <dt>Based in</dt>
          <dd>{site.location}</dd>
        </div>
        <div>
          <dt>Education</dt>
          <dd>
            {education.program}
            <span>
              {education.institution}, {education.location}
            </span>
          </dd>
        </div>
        <div>
          <dt>Focus</dt>
          <dd>
            Full-stack engineering &amp; applied AI
            <span>
              Web development, ML systems, and analytics pipelines.
            </span>
          </dd>
        </div>
      </dl>
    </section>

    <section class="about-tools" aria-labelledby="tools-title">
      <h2 id="tools-title">
        Technical skills<span class="accent">.</span>
      </h2>
      <dl class="resume-skills">
        {skills.map((skill) => (
          <div>
            <dt>{skill.label}</dt>
            <dd>{skill.items}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="capability-section" aria-labelledby="capabilities-title">
      <div class="section-heading">
        <div>
          <h2 id="capabilities-title">
            Core technical areas<span class="accent">.</span>
          </h2>
        </div>
      </div>
      <div class="capability-grid">
        {capabilities.map((item) => (
          <article class="capability-card">
            <span class="mono capability-number">{item.number} /</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <div class="capability-links">
              {item.links.map((link) => (
                <a class="text-link" href={link.href}>
                  {link.title}
                  <Arrow />
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="community-section" aria-labelledby="community-title">
      <div class="section-heading">
        <div>
          <h2 id="community-title">
            Leadership &amp; community<span class="accent">.</span>
          </h2>
        </div>
        <p class="section-note">
          Organizing technical workshops, mentoring peers,
          <br />
          and connecting students directly with industry.
        </p>
      </div>

      <div class="community-grid">
        <article class="community-card">
          <div class="community-card-header">
            <span class="mono community-role">
              Executive Committee · Head of Publicity · Year 2 Sem 1 – Present
            </span>
            <h3>NYP AI</h3>
            <p class="community-lead">
              Executive Committee of NYP AI directing multi-channel outreach
              across Instagram, Telegram, Discord, and WhatsApp Community
              channels, while collaborating with the team on event planning,
              proposals, and logistics.
            </p>
          </div>

          <div class="community-event">
            <div class="community-event-details">
              <h4>Powering the Future — Networks &amp; AI by Nokia</h4>
              <p>
                Co-organized and led publicity for an intensive 2-day systems
                engineering masterclass (18 hours across 18–19 June) hosted at
                NYP, featuring <strong>Thomas Corre</strong>, Regional PLM &amp;
                Consulting Engineer at Nokia (certified Google Cloud
                Professional Cloud Architect &amp; Nokia Service Routing
                Architect). Curated for 50+ selected diploma students with
                networking and AI backgrounds, the sessions explored how modern
                AI compute clusters rely on high-bandwidth data centre
                infrastructure:
              </p>
              <ul class="community-list">
                <li>
                  <strong>Connecting Students with Industry:</strong>{' '}
                  Collaborated with Nokia engineering leadership to bring
                  real-world network architecture into the student community,
                  giving peers direct access to enterprise engineering insights
                  and mentorship.
                </li>
                <li>
                  <strong>Multi-Channel Promotion &amp; Full Turnout:</strong>{' '}
                  Spearheaded promotional outreach across student message
                  channels, cohort broadcasts, and social platforms (@nyp_ai) to
                  fill all 50+ workshop seats.
                </li>
                <li>
                  <strong>Lab Mentorship &amp; Event Support:</strong> Supported
                  attendees during hands-on digital twin exercises and lab
                  checkpoints, helping participants troubleshoot setups
                  alongside the speaker to earn co-issued Nokia e-certificates.
                </li>
              </ul>
            </div>
            <figure class="community-figure">
              <Image
                src={nypAiNokia}
                alt="NYP AI Executive Committee with Nokia guest speaker Thomas Corre at the Networks and AI workshop"
                widths={[480, 800, 1200]}
                sizes="(max-width: 768px) calc(100vw - 40px), 520px"
                format="webp"
                quality={85}
              />
              <figcaption>
                The NYP AI Executive Committee organizing team alongside guest
                speaker Thomas Corre (Nokia) at the conclusion of the 2-day
                Networks &amp; AI workshop.
              </figcaption>
            </figure>
          </div>

          <div class="community-subevent">
            <h4>
              NYP AI Engagement Session – Project Starbound: The AI Frontier
            </h4>
            <p>
              Helped organize NYP AI's orientation and engagement session for
              100+ students, welcoming new cohorts through an interactive,
              space-exploration theme:
            </p>
            <ul class="community-list">
              <li>
                <strong>Interactive Community Activities:</strong> Co-designed
                accessible, team-based activities — including friendly debates
                on AI ethics (<em>Galactic Consensus</em>), interactive machine
                learning trivia (<em>Starfield AI</em>), and a campus-wide
                scavenger hunt (<em>The Nebula Hunt</em>) — to help new students
                connect and break the ice.
              </li>
              <li>
                <strong>Collaborative Event Planning:</strong> Contributed to
                run-of-show scheduling, venue logistics across campus, and
                facilitator briefings to create an organized and welcoming
                experience for incoming cohorts.
              </li>
              <li>
                <strong>Cohort Outreach:</strong> Coordinated publicity across
                WhatsApp communities, Telegram channels, Instagram, and School
                of IT display screens to welcome students across diplomas.
              </li>
            </ul>
          </div>
        </article>

        <article class="community-card">
          <div class="community-card-header">
            <span class="mono community-role">
              Subcommittee · Year 1 Sem 1 – Sem 2
            </span>
            <h3>NYP Google Developer Group (GDGoC)</h3>
            <p class="community-lead">
              Part of the GDGoC NYP subcommittee supporting technical workshops,
              hands-on developer sessions, and outreach initiatives on cloud
              architecture, containerization, and programming logic.
            </p>
          </div>

          <div class="community-event">
            <div class="community-event-details">
              <h4>Cloud &amp; AI Workshops @ NUS</h4>
              <p>
                Delivered an interactive workshop as part of the{' '}
                <strong>Cloud &amp; AI Workshops</strong>, organized jointly by{' '}
                <strong>GDGoC NYP × Developer Group @ NUS Computing</strong> and
                hosted on-campus at the{' '}
                <strong>National University of Singapore (NUS)</strong>. As one
                of three presenters, I guided university students through
                container basics and serverless cloud workflows:
              </p>
              <ul class="community-list">
                <li>
                  <strong>Step-by-Step Cloud Walkthroughs:</strong> Co-presented
                  practical demonstrations breaking down container concepts and
                  serverless architecture into clear, approachable steps —
                  taking attendees from source code to live services on Google
                  Cloud Run.
                </li>
                <li>
                  <strong>Live Peer Coaching &amp; Troubleshooting:</strong>{' '}
                  Mentored attendees during hands-on exercises in Google Cloud
                  Shell, helping them debug deployment issues and build
                  confidence working with cloud tools.
                </li>
                <li>
                  <strong>Cross-Campus Tech Community:</strong> Collaborated
                  with the NUS Computing developer community to facilitate
                  shared peer learning between polytechnic and university
                  students.
                </li>
              </ul>
            </div>
            <div class="community-image-pair">
              <figure class="community-figure">
                <Image
                  src={gdgPresenting}
                  alt="GDGoC NYP team alongside the Developer Group @ NUS Computing team at NUS"
                  widths={[480, 800]}
                  sizes="(max-width: 768px) calc(100vw - 40px), 330px"
                  format="webp"
                  quality={85}
                />
                <figcaption>
                  The representing GDGoC NYP team alongside the Developer Group
                  @ NUS Computing team at the workshop venue.
                </figcaption>
              </figure>
              <figure class="community-figure">
                <Image
                  src={gdgTeam}
                  alt="Kicking off the workshop presentation and teaching session for attendees at NUS Computing"
                  widths={[480, 800]}
                  sizes="(max-width: 768px) calc(100vw - 40px), 330px"
                  format="webp"
                  quality={85}
                  class="community-img-presenting"
                />
                <figcaption>
                  Starting the workshop presentation and teaching session for
                  students at the NUS Computing venue.
                </figcaption>
              </figure>
            </div>
          </div>

          <div class="community-subevent">
            <h4>NYP Course Advising – Programming Logic</h4>
            <p>
              Represented GDGoC NYP as a station presenter during NYP's course
              advising outreach, introducing visiting secondary school students
              to the fundamentals of computational thinking and programming:
            </p>
            <ul class="community-list">
              <li>
                <strong>Making Logic Approachable:</strong> Demystified core
                programming concepts using intuitive real-world analogies,
                helping beginners understand how software makes decisions
                without getting bogged down by dry syntax.
              </li>
              <li>
                <strong>Interactive Problem-Solving:</strong> Guided students
                through hands-on logic activities — such as designing
                conditional rules for an automated smart lamp — encouraging them
                to reason through inputs, conditions, and outcomes.
              </li>
              <li>
                <strong>Inspiring Young Learners:</strong> Shared personal
                enthusiasm for technology and polytechnic studies, answering
                questions and creating an encouraging, low-pressure space for
                kids taking their very first steps into coding.
              </li>
            </ul>
          </div>
        </article>

        <article class="community-card community-card-compact">
          <div class="community-card-header">
            <span class="mono community-role">
              Class AA2502 · Year 1 Sem 1 – Sem 2
            </span>
            <h3>Class Representative</h3>
            <p>
              Coordinated class feedback and bridged communication with academic
              mentors across both Year 1 semesters, while organizing class
              bonding events to foster strong peer support and collaboration
              among classmates.
            </p>
          </div>
        </article>
      </div>
    </section>

    <div class="inner-page-actions">
      <a class="button button-primary" href="/resume/">
        View my resume <Arrow />
      </a>
      <a class="text-link" href="/#work">
        Explore projects <Arrow direction="right" />
      </a>
    </div>
  </div>
</SiteLayout>
