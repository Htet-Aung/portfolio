---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import { education, skills } from '../data/resume';
import { site } from '../data/site';
import { Image } from 'astro:assets';
import nypAiNokia from '../assets/community/nyp-ai-nokia-workshop.png';
import gdgPresenting from '../assets/community/gdg-cloud-run-presenting.png';
import gdgTeam from '../assets/community/gdg-cloud-run-team.png';

const capabilities = [
  {
    number: '01',
    title: 'Full-stack web development',
    text: 'TypeScript and React interfaces, Node.js and Flask backends, Zustand state, and MV3 browser extensions.',
  },
  {
    number: '02',
    title: 'ML & solver engines from scratch',
    text: 'Reverse-mode autograd and vectorized convolutions in pure NumPy, plus bitmask constraint solvers and 76-technique graph scanners in TypeScript.',
  },
  {
    number: '03',
    title: 'AI & media pipelines',
    text: 'Asynchronous multimodal workflows, lyric-synced timeline editing, FFmpeg assembly, and reviewable assistant edits.',
  },
  {
    number: '04',
    title: 'BI & predictive modeling',
    text: 'Power BI capacity simulators, DAX star schemas, automated KNIME data prep, and SAS Viya regression.',
  },
];
---

<SiteLayout
  title={`About — ${site.name}`}
  description="Learn about Htet Aung Khant's experience across full-stack development, applied AI, machine learning systems, and business intelligence."
>
  <div class="container inner-page about-page">
    <section class="about-profile" aria-labelledby="about-page-title">
      <div>
        <h1 id="about-page-title">
          Software engineering
          <br />
          &amp; applied AI<span class="accent">.</span>
        </h1>
        <p class="inner-page-intro">
          Progress comes from being willing to attempt what you don't yet know
          how to do.
        </p>
        <p>
          I'm Htet, an Applied AI &amp; Analytics student at Nanyang Polytechnic
          in Singapore. Most of what I build starts with a real problem I've run
          into myself, or a system I want to understand from the inside out.
        </p>
        <p>
          Outside of code, I play rapid chess (1750 on Chess.com) and solve
          Sudoku. When I got stuck on harder Sudoku puzzles, existing solvers
          only gave away the next move instead of teaching the logic behind
          it—so I built oxyDoku, a 76-technique analysis and training platform
          with a live-sync Chrome extension. When I wanted to see how neural
          networks actually learn beneath PyTorch, I built NumPyGrad from first
          principles in pure NumPy. That same habit carries into my team and
          analytics projects, from AI video studios and 24-hour hackathon builds
          to hospital capacity simulators in Power BI.
        </p>
      </div>
      <dl class="profile-notes">
        <div>
          <dt>Based in</dt>
          <dd>{site.location}</dd>
        </div>
        <div>
          <dt>Education</dt>
          <dd>
            {education.program}
            <span>
              {education.institution}, {education.location}
            </span>
          </dd>
        </div>
        <div>
          <dt>Leadership</dt>
          <dd>
            President, NYP AI
            <span>
              Technical workshops, industry sessions &amp; student community.
            </span>
          </dd>
        </div>
        <div>
          <dt>Focus</dt>
          <dd>
            Full-stack engineering, AI &amp; analytics
            <span>Web apps, ML &amp; solver engines, and BI pipelines.</span>
          </dd>
        </div>
      </dl>
    </section>

    <section class="about-tools" aria-labelledby="tools-title">
      <h2 id="tools-title">
        Technical skills<span class="accent">.</span>
      </h2>
      <dl class="resume-skills">
        {skills.map((skill) => (
          <div>
            <dt>{skill.label}</dt>
            <dd>{skill.items}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="capability-section" aria-labelledby="capabilities-title">
      <h2 id="capabilities-title">
        Core technical areas<span class="accent">.</span>
      </h2>
      <div class="capability-grid">
        {capabilities.map((item) => (
          <article class="capability-card">
            <span class="mono capability-number">{item.number} /</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="community-section" aria-labelledby="community-title">
      <div class="section-heading">
        <div>
          <h2 id="community-title">
            Leadership &amp; community<span class="accent">.</span>
          </h2>
        </div>
        <p class="section-note">
          Organizing technical workshops, mentoring peers,
          <br />
          and connecting students directly with industry.
        </p>
      </div>

      <div class="community-grid">
        <article class="community-card">
          <div class="community-card-header">
            <span class="mono community-role">
              President (Year 2 Sem 2 – Present) |{' '}
              <em>Executive Committee · Head of Publicity (Year 2 Sem 1)</em>
            </span>
            <h3>NYP AI</h3>
            <p class="community-lead">
              Leading NYP AI with the Executive Committee across technical
              workshops, industry masterclasses, and cohort events—after
              previously running multi-channel publicity across Instagram,
              Telegram, Discord, and WhatsApp in Year 2 Sem 1.
            </p>
          </div>

          <div class="community-event">
            <div class="community-event-details">
              <h4>Powering the Future — Networks &amp; AI by Nokia</h4>
              <p>
                Co-organized and led publicity for an intensive 2-day systems
                engineering masterclass (18 hours across June 18–19) hosted at
                NYP, featuring <strong>Thomas Corre</strong>, Regional PLM &amp;
                Consulting Engineer at Nokia (certified Google Cloud
                Professional Cloud Architect &amp; Nokia Service Routing
                Architect). Curated for 50+ selected diploma students with
                networking and AI backgrounds, the sessions explored how modern
                AI compute clusters rely on high-bandwidth data center
                infrastructure:
              </p>
              <ul class="community-list">
                <li>
                  <strong>Connecting Students with Industry:</strong> Worked
                  with Nokia engineers to bring real data-center and network
                  architecture topics to campus, giving students direct time
                  with practicing systems engineers.
                </li>
                <li>
                  <strong>Multi-Channel Outreach &amp; Full Turnout:</strong>{' '}
                  Ran promotion across student chat channels, cohort broadcasts,
                  and @nyp_ai social accounts to fill all 50+ seats.
                </li>
                <li>
                  <strong>Lab Mentorship &amp; Facilitation:</strong> Walked the
                  room during hands-on digital twin labs and checkpoints,
                  helping attendees debug their setups alongside the speaker to
                  complete their co-issued Nokia e-certificates.
                </li>
              </ul>
            </div>
            <figure class="community-figure">
              <Image
                src={nypAiNokia}
                alt="NYP AI Executive Committee with Nokia guest speaker Thomas Corre at the Networks and AI workshop"
                widths={[480, 800, 1200]}
                sizes="(max-width: 768px) calc(100vw - 40px), 520px"
                format="webp"
                quality={85}
              />
              <figcaption>
                The NYP AI Executive Committee organizing team alongside guest
                speaker Thomas Corre (Nokia) at the conclusion of the 2-day
                Networks &amp; AI workshop.
              </figcaption>
            </figure>
          </div>

          <div class="community-subevent">
            <h4>
              NYP AI Engagement Session — Project Starbound: The AI Frontier
            </h4>
            <p>
              Co-organized NYP AI's orientation and engagement session for 100+
              students, welcoming new cohorts through an interactive,
              space-exploration theme:
            </p>
            <ul class="community-list">
              <li>
                <strong>Interactive Community Activities:</strong> Co-designed
                team icebreakers—including AI ethics debates (
                <em>Galactic Consensus</em>), machine learning trivia (
                <em>Starfield AI</em>), and a campus-wide scavenger hunt (
                <em>The Nebula Hunt</em>)—so incoming students could meet people
                across cohorts.
              </li>
              <li>
                <strong>Event Operations:</strong> Co-planned the run-of-show,
                campus venue routing, and facilitator briefings for 100+
                attendees.
              </li>
              <li>
                <strong>Cohort Outreach:</strong> Coordinated announcements
                across WhatsApp communities, Telegram channels, Instagram, and
                School of IT display screens.
              </li>
            </ul>
          </div>
        </article>

        <article class="community-card">
          <div class="community-card-header">
            <span class="mono community-role">
              Subcommittee (Year 1 Sem 1 – Sem 2)
            </span>
            <h3>NYP Google Developer Group (GDGoC)</h3>
            <p class="community-lead">
              Part of the GDGoC NYP subcommittee co-organizing technical
              workshops, hands-on developer sessions, and outreach initiatives
              on cloud architecture, containerization, and programming logic.
            </p>
          </div>

          <div class="community-event">
            <div class="community-event-details">
              <h4>Cloud &amp; AI Workshops @ NUS</h4>
              <p>
                Delivered an interactive workshop as part of the{' '}
                <strong>Cloud &amp; AI Workshops</strong>, organized jointly by{' '}
                <strong>GDGoC NYP × Developer Group @ NUS Computing</strong> and
                hosted on-campus at the{' '}
                <strong>National University of Singapore (NUS)</strong>. As one
                of three presenters, I guided university students through
                container basics and serverless cloud workflows:
              </p>
              <ul class="community-list">
                <li>
                  <strong>Hands-On Cloud Walkthroughs:</strong> Co-presented
                  practical demos taking attendees from source code to live
                  containers on Google Cloud Run.
                </li>
                <li>
                  <strong>Live Debugging &amp; Coaching:</strong> Helped
                  participants troubleshoot deployment issues in Google Cloud
                  Shell during the lab segments.
                </li>
                <li>
                  <strong>Cross-Campus Collaboration:</strong> Worked with the
                  Developer Group @ NUS Computing team to run a joint session
                  for polytechnic and university students.
                </li>
              </ul>
            </div>
            <div class="community-image-pair">
              <figure class="community-figure">
                <Image
                  src={gdgPresenting}
                  alt="GDGoC NYP team alongside the Developer Group @ NUS Computing team at NUS"
                  widths={[480, 800]}
                  sizes="(max-width: 768px) calc(100vw - 40px), 330px"
                  format="webp"
                  quality={85}
                />
                <figcaption>
                  The representing GDGoC NYP team alongside the Developer Group
                  @ NUS Computing team at the workshop venue.
                </figcaption>
              </figure>
              <figure class="community-figure">
                <Image
                  src={gdgTeam}
                  alt="Kicking off the workshop presentation and teaching session for attendees at NUS Computing"
                  widths={[480, 800]}
                  sizes="(max-width: 768px) calc(100vw - 40px), 330px"
                  format="webp"
                  quality={85}
                  class="community-img-presenting"
                />
                <figcaption>
                  Starting the workshop presentation and teaching session for
                  students at the NUS Computing venue.
                </figcaption>
              </figure>
            </div>
          </div>

          <div class="community-subevent">
            <h4>NYP Course Advising — Programming Logic</h4>
            <p>
              Represented GDGoC NYP as a station presenter during NYP's course
              advising outreach, introducing visiting secondary school students
              to the fundamentals of computational thinking and programming:
            </p>
            <ul class="community-list">
              <li>
                <strong>Approachable Logic Demos:</strong> Explained core
                programming concepts through everyday analogies rather than dry
                syntax.
              </li>
              <li>
                <strong>Interactive Problem-Solving:</strong> Walked students
                through conditional logic puzzles—like designing rules for an
                automated smart lamp—to show how inputs map to decisions.
              </li>
              <li>
                <strong>Welcoming First-Timers:</strong> Answered questions
                about polytechnic life and computing for secondary school
                visitors trying code for the first time.
              </li>
            </ul>
          </div>
        </article>

        <article class="community-card community-card-compact">
          <div class="community-card-header">
            <span class="mono community-role">
              Class AA2502 (Year 1 Sem 1 – Sem 2)
            </span>
            <h3>Class Representative</h3>
            <p>
              Relayed class feedback to academic mentors across both Year 1
              semesters and organized class bonding events for AA2502.
            </p>
          </div>
        </article>

        <article class="community-card community-card-compact">
          <div class="community-card-header">
            <span class="mono community-role">NYP Semi-finalist (2026)</span>
            <h3>SDG Open Hack 2026</h3>
            <p>
              Co-built and pitched ROLLOVER—a circular-retail discovery platform
              matching surplus inventory into constraint-checked mystery
              bundles—with a three-person team in a 24-hour hackathon sprint.
            </p>
          </div>
        </article>
      </div>
    </section>

    <div class="inner-page-actions">
      <a class="button button-primary" href="/resume/">
        View my resume <Arrow />
      </a>
      <a class="text-link" href="/#work">
        Explore projects <Arrow direction="right" />
      </a>
    </div>
  </div>
</SiteLayout>
