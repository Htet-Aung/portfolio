---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPublishedProjects } from '../data/work';

const visibleProjects = await getPublishedProjects();
const groups = [
  {
    id: 'software',
    title: 'Software & AI',
    description:
      'Full-stack applications, machine learning tools, and core systems.',
  },
  {
    id: 'analytics',
    title: 'Data & Analytics',
    description:
      'Dashboards, predictive modeling pipelines, and business intelligence.',
  },
];
---

<SiteLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <h1 id="hero-title">
      I build useful software
      <span>and the systems behind it.</span>
    </h1>
    <div class="hero-bottom">
      <p>
        I'm Htet, an Applied AI &amp; Analytics student at Nanyang Polytechnic.
        I build full-stack web applications, machine learning systems from scratch,
        and data analytics tools—focusing on clean code and reliable architecture.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">
          Explore my work <Arrow direction="down" />
        </a>
        <a class="text-link" href="/resume/">
          View resume <Arrow direction="right" />
        </a>
      </div>
    </div>
  </section>

  <section
    class="work-section container section-space"
    id="work"
    aria-labelledby="work-title"
  >
    <div class="section-heading">
      <h2 id="work-title">
        Selected work<span class="accent">.</span>
      </h2>
    </div>

    {groups.map((group) => (
      <section
        class="work-group"
        id={`${group.id}-work`}
        aria-labelledby={`${group.id}-title`}
      >
        <div class="work-group-heading">
          <h3 id={`${group.id}-title`}>{group.title}</h3>
          <p>{group.description}</p>
        </div>
        <div class="project-grid">
          {visibleProjects
            .filter((project) => project.group === group.id)
            .map((project) => (
              <ProjectCard project={project} />
            ))}
        </div>
      </section>
    ))}
  </section>

  <section
    class="about-section container section-space"
    id="about"
    aria-labelledby="about-title"
  >
    <div class="about-heading">
      <h2 id="about-title">
        Building software
        <br />
        from the ground up<span class="accent">.</span>
      </h2>
      <p class="about-location">
        <span class="location-dot" aria-hidden="true"></span>Singapore
      </p>
    </div>
    <div class="about-copy">
      <p class="about-intro">
        I enjoy building software across the entire stack—from responsive web
        interfaces to the underlying machine learning models and data pipelines.
      </p>
      <p>
        My work spans building an autograd deep learning engine in pure NumPy,
        full-stack React and Flask applications, and predictive analytics in
        KNIME and SAS Viya. I care about writing clean, maintainable code and
        understanding how things work under the hood.
      </p>
      <p>
        Currently pursuing a Diploma in Applied AI &amp; Analytics at Nanyang
        Polytechnic, active in student tech communities, and always building
        new projects.
      </p>
      <a class="text-link" href="/about/">
        More about me <Arrow />
      </a>
      <div class="about-focus">
        <h3>Areas of focus</h3>
        <ul>
          <li>Full-stack development</li>
          <li>Machine learning systems</li>
          <li>Data analytics & visualization</li>
        </ul>
      </div>
    </div>
  </section>
</SiteLayout>
