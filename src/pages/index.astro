---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPublishedProjects } from '../data/work';
const visibleProjects = await getPublishedProjects();
---

<SiteLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <p class="eyebrow hero-eyebrow">
      <span class="location-dot" aria-hidden="true"></span>
      <span>Singapore</span>
      <span class="eyebrow-divider" aria-hidden="true">
        /
      </span>
      <span>Software engineering + applied AI</span>
    </p>
    <h1 id="hero-title">
      I build useful software
      <span>and the systems behind it.</span>
    </h1>
    <div class="hero-bottom">
      <p>
        I'm Htet. I work across full-stack products, media workflows, and
        machine learning systems. I care about how things work, and who they
        work for.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">
          Explore my work <Arrow direction="down" />
        </a>
        <a class="text-link" href="/resume/">
          View resume <Arrow direction="right" />
        </a>
      </div>
    </div>
  </section>

  <div class="proof-strip">
    <div class="container proof-inner">
      <a href="/work/numpygrad/">
        <span class="proof-number">01 /</span>
        <span>Autograd, from first principles</span>
        <Arrow direction="up-right" />
      </a>
      <a href="/work/shades-of-sg/">
        <span class="proof-number">02 /</span>
        <span>Human-guided media workflows</span>
        <Arrow direction="up-right" />
      </a>
      <a href="/work/sgen/">
        <span class="proof-number">03 /</span>
        <span>Accessible product experiences</span>
        <Arrow direction="up-right" />
      </a>
    </div>
  </div>

  <section
    class="work-section container section-space"
    id="work"
    aria-labelledby="work-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">A few things I've built</p>
        <h2 id="work-title">
          Selected work<span class="accent">.</span>
        </h2>
      </div>
      <p class="section-note">
        Different problems.
        <br />
        The same curiosity.
      </p>
    </div>
    <div class="project-grid">
      {visibleProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <section
    class="about-section container section-space"
    id="about"
    aria-labelledby="about-title"
  >
    <div class="about-heading">
      <p class="eyebrow">A little about me</p>
      <h2 id="about-title">
        Curious about
        <br />
        the whole system<span class="accent">.</span>
      </h2>
      <p class="about-location">
        <span class="location-dot" aria-hidden="true"></span>Based in Singapore
      </p>
    </div>
    <div class="about-copy">
      <p class="about-intro">
        I like moving between the part you interact with and the machinery that
        makes it possible.
      </p>
      <p>
        That has taken me from building an accessible social feed to shaping a
        media generation workflow, and down to writing the gradient engine
        behind a neural network.
      </p>
      <p>
        My background is in Applied AI & Analytics at Nanyang Polytechnic.
        Across projects, I try to make the decisions visible: what I built, why
        I chose it, and what I'd improve.
      </p>
      <a class="text-link" href="/about/">
        More about me <Arrow />
      </a>
      <div class="about-focus">
        <span class="mono">Areas of focus</span>
        <ul>
          <li>Full-stack development</li>
          <li>Machine learning systems</li>
          <li>Accessible interfaces</li>
        </ul>
      </div>
    </div>
  </section>
</SiteLayout>
