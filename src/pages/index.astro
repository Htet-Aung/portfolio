---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPublishedProjects } from '../data/work';

const visibleProjects = await getPublishedProjects();
const groups = [
  {
    id: 'software',
    title: 'Software & AI',
    description:
      'Full-stack web apps, from-scratch ML & solver engines, and AI media tools.',
  },
  {
    id: 'analytics',
    title: 'Data & Analytics',
    description:
      'Operational BI dashboards, data preparation pipelines, and predictive models.',
  },
];
---

<SiteLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <h1 id="hero-title">
      I build useful software
      <span>and the systems behind it.</span>
    </h1>
    <div class="hero-bottom">
      <p>
        I'm Htet, an Applied AI &amp; Analytics student at Nanyang Polytechnic
        and President of NYP AI. I build tools to solve real problems and
        understand how systems work—from a 76-technique Sudoku trainer and a
        pure-NumPy deep learning engine to full-stack web apps and operational
        dashboards.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">
          Explore my work <Arrow direction="down" />
        </a>
        <a class="text-link" href="/resume/">
          View resume <Arrow direction="right" />
        </a>
      </div>
    </div>
  </section>

  <section
    class="work-section container section-space"
    id="work"
    aria-labelledby="work-title"
  >
    <div class="section-heading">
      <h2 id="work-title">
        Selected work<span class="accent">.</span>
      </h2>
    </div>

    {groups.map((group) => (
      <section
        class="work-group"
        id={`${group.id}-work`}
        aria-labelledby={`${group.id}-title`}
      >
        <div class="work-group-heading">
          <h3 id={`${group.id}-title`}>{group.title}</h3>
          <p>{group.description}</p>
        </div>
        <div class="project-grid">
          {visibleProjects
            .filter((project) => project.group === group.id)
            .map((project) => (
              <ProjectCard project={project} />
            ))}
        </div>
      </section>
    ))}
  </section>

  <section
    class="about-section container section-space"
    id="about"
    aria-labelledby="about-title"
  >
    <div class="about-heading">
      <h2 id="about-title">
        Building software
        <br />
        from the ground up<span class="accent">.</span>
      </h2>
      <p class="about-location">
        <span class="location-dot" aria-hidden="true"></span>Singapore
      </p>
    </div>
    <div class="about-copy">
      <p class="about-intro">
        Most of my favorite projects start with a real problem I've run into
        myself, or a system I don't want to treat as a black box.
      </p>
      <p>
        When I wanted to get better at hard Sudoku puzzles and realized most
        apps only hand out next-move hints instead of teaching the pattern
        behind them, I built oxyDoku—a 76-technique pattern scanner, proof
        verifier, and live-sync Chrome extension to train my own solving. When I
        wanted to see what actually happens during backpropagation, I wrote an
        autograd engine and inspection studio from scratch in pure NumPy.
      </p>
      <p>
        Beyond solo engines, I build full-stack React, Node.js, and Flask
        applications, turn messy datasets into Power BI planning simulators and
        predictive models in KNIME and SAS Viya, and serve as President of NYP
        AI—organizing technical workshops and industry sessions for students.
      </p>
      <a class="text-link" href="/about/">
        More about me <Arrow />
      </a>
      <div class="about-focus">
        <h3>Areas of focus</h3>
        <ul>
          <li>Full-stack web &amp; AI applications</li>
          <li>ML &amp; solver engines from scratch</li>
          <li>Operational BI &amp; predictive analytics</li>
        </ul>
      </div>
    </div>
  </section>
</SiteLayout>
