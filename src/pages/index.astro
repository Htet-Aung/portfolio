---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPublishedProjects } from '../data/work';
const visibleProjects = await getPublishedProjects();
const groups = [
  {
    id: 'software',
    title: 'Software & AI',
    description:
      'Applications, creative workflows, and the systems behind them.',
  },
  {
    id: 'analytics',
    title: 'Data & Analytics',
    description:
      'From messy inputs to dashboards, predictions, and statistical findings.',
  },
];
---

<SiteLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <p class="eyebrow hero-eyebrow">
      <span class="location-dot" aria-hidden="true"></span>
      <span>Singapore</span>
      <span class="eyebrow-divider" aria-hidden="true">
        /
      </span>
      <span>Software + AI + analytics</span>
    </p>
    <h1 id="hero-title">
      I build useful software
      <span>and the systems behind it.</span>
    </h1>
    <div class="hero-bottom">
      <p>
        I'm Htet. I build full-stack products, AI workflows, and data tools.
        From a video editor to a Power BI dashboard, I care about how things
        work and what they help people understand.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">
          Explore my work <Arrow direction="down" />
        </a>
        <a class="text-link" href="/resume/">
          View resume <Arrow direction="right" />
        </a>
      </div>
    </div>
  </section>

  <div class="proof-strip">
    <div class="container proof-inner">
      <a href="/work/numpygrad/">
        <span class="proof-number">01 /</span>
        <span>Autograd, from first principles</span>
        <Arrow direction="up-right" />
      </a>
      <a href="/work/shades-of-sg/">
        <span class="proof-number">02 /</span>
        <span>Human-guided media workflows</span>
        <Arrow direction="up-right" />
      </a>
      <a href="/work/hospital-operations/">
        <span class="proof-number">03 /</span>
        <span>Data into decision support</span>
        <Arrow direction="up-right" />
      </a>
    </div>
  </div>

  <section
    class="work-section container section-space"
    id="work"
    aria-labelledby="work-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">Things I've built and explored</p>
        <h2 id="work-title">
          Selected work<span class="accent">.</span>
        </h2>
      </div>
      <p class="section-note">
        Different problems.
        <br />
        The same curiosity.
      </p>
    </div>
    <nav class="work-group-links" aria-label="Project areas">
      {groups.map((group) => (
        <a href={`#${group.id}-work`}>
          {group.title}
          <span>
            {String(
              visibleProjects.filter((project) => project.group === group.id)
                .length,
            ).padStart(2, '0')}
          </span>
        </a>
      ))}
    </nav>
    {groups.map((group) => (
      <section
        class="work-group"
        id={`${group.id}-work`}
        aria-labelledby={`${group.id}-title`}
      >
        <div class="work-group-heading">
          <h3 id={`${group.id}-title`}>{group.title}</h3>
          <p>{group.description}</p>
        </div>
        <div class="project-grid">
          {visibleProjects
            .filter((project) => project.group === group.id)
            .map((project) => (
              <ProjectCard project={project} />
            ))}
        </div>
      </section>
    ))}
  </section>

  <section
    class="about-section container section-space"
    id="about"
    aria-labelledby="about-title"
  >
    <div class="about-heading">
      <p class="eyebrow">A little about me</p>
      <h2 id="about-title">
        Curious about
        <br />
        the whole system<span class="accent">.</span>
      </h2>
      <p class="about-location">
        <span class="location-dot" aria-hidden="true"></span>Based in Singapore
      </p>
    </div>
    <div class="about-copy">
      <p class="about-intro">
        I like moving between the part you interact with and the machinery that
        makes it possible.
      </p>
      <p>
        That has taken me from an accessible social feed and a music video
        editor to a gradient engine, hospital dashboards, and predictive
        modeling. I enjoy working through both the software and the data.
      </p>
      <p>
        My background is in Applied AI & Analytics at Nanyang Polytechnic.
        Across projects, I try to make the decisions visible: what I built, why
        I chose it, and what I'd improve.
      </p>
      <a class="text-link" href="/about/">
        More about me <Arrow />
      </a>
      <div class="about-focus">
        <span class="mono">Areas of focus</span>
        <ul>
          <li>Full-stack development</li>
          <li>Machine learning systems</li>
          <li>Data analytics & visualization</li>
        </ul>
      </div>
    </div>
  </section>
</SiteLayout>
