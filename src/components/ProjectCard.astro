---
import type { Project } from '../data/projects';
import Arrow from './Arrow.astro';
import ProjectCover from './ProjectCover.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card">
  <ProjectCover project={project.id} />
  <div class="project-card-body">
    <div class="project-category">
      <span>{project.category}</span>
    </div>
    <h4>
      {project.caseStudy ? (
        <a href={project.caseStudy}>{project.title}</a>
      ) : (
        project.title
      )}
    </h4>
    <p class="project-kind">{project.descriptor}</p>
    <p class="project-summary">{project.summary}</p>
    <ul class="stack-list" aria-label={`${project.title} technologies`}>
      {project.stack.map((tech) => (
        <li>{tech}</li>
      ))}
    </ul>
    {project.caseStudy ? (
      <a class="text-link project-action" href={project.caseStudy}>
        Read case study <Arrow direction="right" />
      </a>
    ) : project.repoUrl ? (
      <a class="text-link project-action" href={project.repoUrl}>
        Explore the source <Arrow direction="up-right" />
      </a>
    ) : (
      <p class="project-action project-pending">Case study coming soon</p>
    )}
  </div>
</article>
