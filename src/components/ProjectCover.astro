---
import type { ProjectId } from '../data/projects';
import AnalyticsCover from './AnalyticsCover.astro';
import NumPyGradCover from './NumPyGradCover.astro';
import OxyDokuCover from './OxyDokuCover.astro';
import RolloverCover from './RolloverCover.astro';
import SgenCover from './SgenCover.astro';
import ShadesCover from './ShadesCover.astro';
import {
  analyticsCovers,
  type AnalyticsProjectId,
} from '../data/analytics-captures';
interface Props {
  project: ProjectId;
  large?: boolean;
}
const { project, large = false } = Astro.props;
---

{project === 'numpygrad' ? (
  <NumPyGradCover large={large} />
) : project === 'oxydoku' ? (
  <OxyDokuCover large={large} />
) : project === 'rollover' ? (
  <RolloverCover large={large} />
) : project === 'shades-of-sg' ? (
  <ShadesCover large={large} />
) : project === 'sgen' ? (
  <SgenCover large={large} />
) : project in analyticsCovers ? (
  <AnalyticsCover project={project as AnalyticsProjectId} large={large} />
) : (
  <div
    class:list={['project-cover', `cover-${project}`, { 'cover-large': large }]}
    aria-hidden="true"
  />
)}
