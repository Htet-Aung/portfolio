---
import { Image, getImage } from 'astro:assets';
import {
  analyticsCaptures,
  analyticsCovers,
  type AnalyticsProjectId,
} from '../data/analytics-captures';
interface Props {
  project: AnalyticsProjectId;
  large?: boolean;
}
const { project, large = false } = Astro.props;
const cover = analyticsCovers[project];
const capture = analyticsCaptures[cover.capture];
const full = large
  ? await getImage({ src: capture.image, format: 'webp', quality: 95 })
  : undefined;
---

<div class:list={['analytics-cover', { 'analytics-cover-large': large }]}>
  <div class="analytics-cover-heading">
    <span>{cover.label}</span>
    <span>{cover.metric}</span>
  </div>
  <Image
    src={capture.image}
    alt={capture.alt}
    widths={[480, 960, 1280]}
    sizes={
      large
        ? '(max-width: 767px) calc(100vw - 40px), 1120px'
        : '(max-width: 767px) calc(100vw - 40px), 544px'
    }
    format="webp"
    quality={85}
    loading="lazy"
    decoding="async"
  />
  <div class="analytics-cover-footer">
    <p class="analytics-cover-detail">{cover.detail}</p>
    {full && (
      <a
        href={full.src}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`View full-size figure: ${capture.title} (opens in a new tab)`}
      >
        View full-size figure
      </a>
    )}
  </div>
</div>
