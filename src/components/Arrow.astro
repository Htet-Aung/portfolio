---
interface Props {
  direction?: 'right' | 'up-right' | 'down' | 'left';
  class?: string;
}
const { direction = 'right', class: className } = Astro.props;
const paths = {
  right: 'M4 12h16m-6-6 6 6-6 6',
  'up-right': 'M6 18 18 6M6 6h12v12',
  down: 'M12 4v16m-6-6 6 6 6-6',
  left: 'M20 12H4m6-6-6 6 6 6',
};
---

<svg
  class:list={['arrow', className]}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[direction]} />
</svg>
