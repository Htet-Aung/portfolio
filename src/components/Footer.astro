---
import Arrow from './Arrow.astro';
import { site } from '../data/site';
---

<footer class="site-footer" id="contact">
  <div class="container">
    <div class="contact-top">
      <div>
        <p class="eyebrow">Contact</p>
        <h2>
          Get in touch<span class="accent">.</span>
        </h2>
      </div>
      <div class="contact-links">
        <p>
          Whether you're looking for an intern, want to collaborate on a
          project, or just want to connect—feel free to drop me an email or
          reach out directly.
        </p>
        <div class="contact-actions">
          <div class="contact-primary">
            <a class="email-link" href={`mailto:${site.email}`}>
              Email me <Arrow direction="up-right" />
            </a>
            <span class="contact-address">{site.email}</span>
          </div>
          <div
            class="contact-secondary"
            role="group"
            aria-label="Other ways to connect"
          >
            <div class="contact-secondary-item">
              <a
                class="secondary-contact-link"
                href={site.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
              >
                WhatsApp <Arrow direction="up-right" />
              </a>
              <span class="contact-address">{site.phone}</span>
            </div>
            <div class="contact-secondary-item">
              <a
                class="secondary-contact-link"
                href={site.linkedin}
                target="_blank"
                rel="noopener noreferrer"
              >
                LinkedIn <Arrow direction="up-right" />
              </a>
              <span class="contact-address">in/htet-ak</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>
        © {new Date().getFullYear()} {site.name}
      </span>
      <span class="footer-location">Based in Singapore</span>
      <div>
        <a href="/resume/">
          Resume <Arrow />
        </a>
        <a href={site.github} target="_blank" rel="noopener noreferrer">
          GitHub <Arrow direction="up-right" />
        </a>
        <a href="#top">
          Back to top <Arrow direction="up-right" />
        </a>
      </div>
    </div>
  </div>
</footer>
