  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "parse5": "8.0.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "0.35.5",
    "typescript": "~5.9.3"
  }
